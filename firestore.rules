rules_version = '2';

// Reglas de seguridad para la app de equipos de Warzone.
service cloud.firestore {
  match /databases/{database}/documents {

    // Dueño: único que nombra o quita admins. Cámbialo aquí y en config.js (OWNER_EMAIL).
    function isOwner() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email == 'aflores@sforce.tech';
    }

    function isAdmin() {
      return isOwner()
        || (request.auth != null && request.auth.token.email is string
            && request.auth.token.email_verified == true
            && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())));
    }

    function playerPath(uid) { return /databases/$(database)/documents/players/$(uid); }
    function handlePath(key) { return /databases/$(database)/documents/handles/$(key); }
    function ownsHandle(key, uid) { return getAfter(handlePath(key)).data.uid == uid; }
    function reqPath(tid, uid) { return /databases/$(database)/documents/joinreqs/$(tid + '_' + uid); }
    function teamPath(tid)   { return /databases/$(database)/documents/teams/$(tid); }

    function validProfile(d) {
      return d.gamertag is string && d.gamertag.size() >= 2 && d.gamertag.size() <= 24
        && !d.gamertag.matches('.*/.*') && d.gamertag != '..'
        && d.activisionId is string && d.activisionId.size() <= 40
        && !d.activisionId.matches('.*/.*')
        && d.platform in ['PC', 'PlayStation', 'Xbox']
        && d.mic is bool
        && (!('trackerUrl' in d) || (d.trackerUrl is string && d.trackerUrl.size() <= 200
            && (d.trackerUrl == '' || d.trackerUrl.matches('https://.*'))));
    }

    function isPlayer() {
      return request.auth != null && exists(/databases/$(database)/documents/players/$(request.auth.uid));
    }

    function validName(n) {
      return n is string && n.size() >= 2 && n.size() <= 30;
    }

    // ---------- JUGADORES ----------
    match /players/{uid} {
      allow read: if true;

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['gamertag', 'activisionId', 'platform', 'mic', 'trackerUrl', 'teamId', 'createdAt', 'updatedAt'])
        && request.resource.data.teamId == null
        && validProfile(request.resource.data)
        // Gamertag y Activision ID únicos: hay que reservarlos en /handles en el mismo batch.
        && ownsHandle('g_' + request.resource.data.gamertag.lower(), uid)
        && (request.resource.data.activisionId == ''
            || ownsHandle('a_' + request.resource.data.activisionId.lower(), uid));

      allow update: if isOwner()
        || profileEdit(uid)
        || (teamIdOnly() && (joining(uid) || leaving(uid)))
        || isAdmin();

      allow delete: if resource.data.teamId == null
        && ((request.auth != null && request.auth.uid == uid) || isAdmin());

      function profileEdit(uid) {
        return request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['gamertag', 'activisionId', 'platform', 'mic', 'trackerUrl', 'updatedAt'])
          && validProfile(request.resource.data)
          && (request.resource.data.gamertag.lower() == resource.data.gamertag.lower()
              || ownsHandle('g_' + request.resource.data.gamertag.lower(), uid))
          && (request.resource.data.activisionId == ''
              || request.resource.data.activisionId.lower() == resource.data.activisionId.lower()
              || ownsHandle('a_' + request.resource.data.activisionId.lower(), uid));
      }

      function teamIdOnly() {
        return request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamId']);
      }

      // Un jugador libre entra a un equipo: lo agrega el capitán (también al crear su
      // propio equipo o al aceptar una solicitud) o el propio jugador acepta una invitación.
      function joining(uid) {
        let t = request.resource.data.teamId;
        return resource.data.teamId == null
          && t is string
          && uid in getAfter(teamPath(t)).data.members
          && ((getAfter(teamPath(t)).data.captainUid == request.auth.uid
                && (uid == request.auth.uid || get(reqPath(t, uid)).data.type == 'request'))
              || (request.auth.uid == uid && get(reqPath(t, uid)).data.type == 'invite'));
      }

      // Un jugador sale de su equipo: lo hace él mismo o su capitán.
      function leaving(uid) {
        let old = resource.data.teamId;
        return old != null
          && request.resource.data.teamId == null
          && (request.auth.uid == uid || get(teamPath(old)).data.captainUid == request.auth.uid)
          && (!existsAfter(teamPath(old)) || !(uid in getAfter(teamPath(old)).data.members));
      }
    }

    // ---------- EQUIPOS ----------
    match /teams/{tid} {
      allow read: if true;

      allow create: if isOwner() || (request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'captainUid', 'members', 'createdAt', 'eventId'])
        && request.resource.data.captainUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && validName(request.resource.data.name)
        && get(playerPath(request.auth.uid)).data.teamId == null
        && getAfter(playerPath(request.auth.uid)).data.teamId == tid)
        || isAdmin();

      allow update: if isOwner()
        || (isCaptain() && captainEdit(tid))
        || memberLeave()
        || inviteJoin(tid)
        || isAdmin();

      allow delete: if (isCaptain() && freed(0) && freed(1) && freed(2) && freed(3))
        || isAdmin();

      function isCaptain() {
        return request.auth != null && resource.data.captainUid == request.auth.uid;
      }

      // El capitán cambia nombre, agrega/quita UN jugador por operación o cede la capitanía.
      function captainEdit(tid) {
        let d = request.resource.data;
        let added = d.members.removeAll(resource.data.members);
        let removed = resource.data.members.removeAll(d.members);
        return d.diff(resource.data).affectedKeys().hasOnly(['name', 'members', 'captainUid'])
          && validName(d.name)
          && d.members is list
          && d.members.size() >= 1 && d.members.size() <= 4
          && d.members.toSet().size() == d.members.size()
          && d.captainUid in d.members
          && added.size() + removed.size() <= 1
          && (added.size() == 0
              || (get(playerPath(added[0])).data.teamId == null
                  && getAfter(playerPath(added[0])).data.teamId == tid
                  && get(reqPath(tid, added[0])).data.type == 'request'))
          && (removed.size() == 0
              || !existsAfter(playerPath(removed[0]))
              || getAfter(playerPath(removed[0])).data.teamId == null);
      }

      // Un miembro (no capitán) se sale por su cuenta.
      function memberLeave() {
        return request.auth != null
          && request.auth.uid in resource.data.members
          && request.auth.uid != resource.data.captainUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
          && getAfter(playerPath(request.auth.uid)).data.teamId == null;
      }

      // Un jugador libre se une aceptando una invitación del capitán.
      function inviteJoin(tid) {
        let uid = request.auth.uid;
        return request.auth != null
          && !(uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members == resource.data.members.concat([uid])
          && request.resource.data.members.size() <= 4
          && get(reqPath(tid, uid)).data.type == 'invite'
          && get(playerPath(uid)).data.teamId == null
          && getAfter(playerPath(uid)).data.teamId == tid;
      }

      // Para disolver el equipo, todos sus miembros deben quedar libres en la misma operación.
      function freed(i) {
        let m = resource.data.members;
        return m.size() <= i || !existsAfter(playerPath(m[i])) || getAfter(playerPath(m[i])).data.teamId == null;
      }
    }

    // ---------- NOMBRES ÚNICOS (id = 'g_' + gamertag o 'a_' + Activision ID, en minúsculas) ----------
    match /handles/{key} {
      allow read: if true;
      // Solo puedes reservar tu propio gamertag / Activision ID (el que queda en tu perfil).
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && (key == 'g_' + getAfter(playerPath(request.auth.uid)).data.gamertag.lower()
            || key == 'a_' + getAfter(playerPath(request.auth.uid)).data.activisionId.lower());
      allow delete: if (request.auth != null && resource.data.uid == request.auth.uid) || isAdmin();
    }

    // ---------- ADMINS (id del documento = correo en minúsculas) ----------
    match /admins/{email} {
      allow read: if request.auth != null
        && (request.auth.token.email.lower() == email || isAdmin());
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['addedAt', 'addedBy']);
      allow delete: if isOwner();
    }

    // ---------- CALENDARIO ----------
    match /events/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 60
        && request.resource.data.startsAt is timestamp;
      allow delete: if isAdmin();
    }

    // ---------- DATOS PRIVADOS DEL LOBBY (solo jugadores registrados) ----------
    match /lobby/{eventId} {
      allow read: if isPlayer() || isAdmin();
      allow write: if isAdmin();
    }

    // ---------- CONFIRMACIONES DE ASISTENCIA (id = eventId_uid) ----------
    match /rsvps/{rid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['eventId', 'uid', 'going', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.going is bool
        && rid == request.resource.data.eventId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && isPlayer();
      allow delete: if (request.auth != null && resource.data.uid == request.auth.uid) || isAdmin();
    }

    // ---------- SOLICITUDES E INVITACIONES (id = teamId_uid) ----------
    // type 'request': el jugador pide entrar. type 'invite': el capitán lo invita.
    match /joinreqs/{rid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['teamId', 'uid', 'type', 'by', 'createdAt'])
        && rid == request.resource.data.teamId + '_' + request.resource.data.uid
        && request.resource.data.by == request.auth.uid
        && get(playerPath(request.resource.data.uid)).data.teamId == null
        && get(teamPath(request.resource.data.teamId)).data.members.size() < 4
        && ((request.resource.data.type == 'request' && request.resource.data.uid == request.auth.uid)
            || (request.resource.data.type == 'invite'
                && get(teamPath(request.resource.data.teamId)).data.captainUid == request.auth.uid));
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || (exists(teamPath(resource.data.teamId))
                && get(teamPath(resource.data.teamId)).data.captainUid == request.auth.uid)
            || isAdmin());
    }

    // ---------- ANUNCIO Y AJUSTES ----------
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- SUGERENCIAS DE HORARIO ----------
    match /suggestions/{id} {
      allow read: if true;
      allow create: if isPlayer()
        && request.resource.data.keys().hasOnly(['uid', 'startsAt', 'note', 'votes', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.startsAt is timestamp
        && request.resource.data.note is string && request.resource.data.note.size() <= 100
        && request.resource.data.votes == [request.auth.uid];
      // Votar: cada quien solo agrega o quita su propio voto.
      allow update: if (isPlayer()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
          && (request.resource.data.votes == resource.data.votes.concat([request.auth.uid])
              && !(request.auth.uid in resource.data.votes)
            || request.resource.data.votes == resource.data.votes.removeAll([request.auth.uid])
              && request.auth.uid in resource.data.votes))
        || isAdmin();
      allow delete: if (request.auth != null && resource.data.uid == request.auth.uid) || isAdmin();
    }

    // ---------- RESULTADOS POR PARTIDA (id = id del evento) ----------
    match /results/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
